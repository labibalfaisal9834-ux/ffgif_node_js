datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String    @db.VarChar(21)
  fullname     String?   @default("") @db.VarChar(100)
  email        String    @unique @db.VarChar(50)
  passwordHash String?   @default("") @map("password_hash") @db.VarChar(70)
  isVerified   Boolean   @default(false) @map("is_verified")
  role         String    @default("user") @db.VarChar(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  verifier       Verifier?
  reseter        Reseter?
  profile        Profile?
  quota          Quota?
  lastUpload     LastUpload?
  gifs           Gif[]
  ownedShares    Share[]     @relation("ShareOwner")
  receivedShares Share[]     @relation("ShareRecipient")
  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")

  @@map("users")
}

model Verifier {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(70)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expireAt  DateTime @map("expire_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expireAt], map: "idx_verifier_expire_at")
  @@map("verifier")
}

model Reseter {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(70)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expireAt  DateTime @map("expire_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expireAt], map: "idx_reseter_expire_at")
  @@map("reseter")
}

model Profile {
  id         Int      @id @default(autoincrement())
  userId     String   @unique @map("user_id") @db.Uuid
  profilePic String?  @default("") @map("profile_pic")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Quota {
  id         Int    @id @default(autoincrement())
  userId     String @unique @map("user_id") @db.Uuid
  usedBytes  BigInt @default(0) @map("used_bytes")
  totalBytes BigInt @default(1073741824) @map("total_bytes")
  gifCount   Int    @default(0) @map("gif_count")
  gifLimit   Int    @default(100) @map("gif_limit")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quota")
}

model LastUpload {
  id           Int       @id @default(autoincrement())
  userId       String    @unique @map("user_id") @db.Uuid
  fileKey      String    @map("file_key")
  fileName     String?   @map("file_name")
  contentType  String    @map("content_type")
  sizeBytes    BigInt?   @map("size_bytes")
  durationSec  Decimal?  @map("duration_sec") @db.Decimal(10, 3)
  thumbnailUrl String?   @map("thumbnail_url")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([uploadedAt], map: "idx_last_upload_uploaded_at")
  @@map("last_upload")
}

model Gif {
  name            String?  @default("")
  key             String   @id
  userId          String   @map("user_id") @db.Uuid
  status          String   @default("private")
  persist         Boolean  @default(false)
  download        Int      @default(0)
  fileSizeBytes   BigInt   @default(0) @map("file_size_bytes")
  width           Int      @default(0)
  height          Int      @default(0)
  durationSeconds Decimal  @default(0.0) @map("duration_seconds") @db.Decimal(6, 2)
  isPublic        Boolean  @default(false) @map("is_public")
  url             String   @default("")
  thumbnailKey    String?  @default("") @map("thumbnail_key")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares      Share[]
  shareTokens ShareToken[]

  @@index([userId, status], map: "idx_gifs_user_id_status")
  @@index([userId, createdAt(sort: Desc)], map: "idx_gifs_user_id_created_at")
  @@map("gifs")
}

model Share {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gifKey     String?   @map("gif_key")
  ownerId    String?   @map("owner_id") @db.Uuid
  sharedWith String?   @map("shared_with") @db.Uuid
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz()
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  gif       Gif?  @relation(fields: [gifKey], references: [key], onDelete: Cascade)
  owner     User? @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient User? @relation("ShareRecipient", fields: [sharedWith], references: [id], onDelete: Cascade)

  @@unique([gifKey, sharedWith])
  @@index([ownerId], map: "idx_shares_owner_id")
  @@index([sharedWith], map: "idx_shares_shared_with")
  @@index([expiresAt], map: "idx_shares_expires_at")
  @@map("shares")
}

model ShareToken {
  gifKey    String    @map("gif_key")
  token     String    @id
  email     String
  expiresAt DateTime? @map("expires_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  gif Gif @relation(fields: [gifKey], references: [key], onDelete: Cascade)

  @@unique([gifKey, email])
  @@index([gifKey], map: "idx_share_tokens_gif_key")
  @@map("share_tokens")
}

model Friendship {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String   @map("requester_id") @db.Uuid
  addresseeId String   @map("addressee_id") @db.Uuid
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  requester User @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId], map: "idx_friendships_requester_id")
  @@index([addresseeId], map: "idx_friendships_addressee_id")
  @@map("friendships")
}

